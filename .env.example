# ==============================================================================
# Wealth Planning & Financial Advisory System - Environment Configuration
# ==============================================================================
# IMPORTANT: Never commit actual secret values to version control.
# Configure these variables in Google AI Studio Secrets or your production environment.

# 1. Autenticação e Credenciais (Obrigatórios Server-side)
CONSULTANT_EMAIL=
CONSULTANT_PASSWORD=
CLIENT_EMAIL=
CLIENT_PASSWORD=
SESSION_SECRET=

# 1b. Persistência server-side do Firestore (obrigatória para dados financeiros)
# Use exatamente uma opção; nunca envie estes valores ao frontend.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternativa: caminho server-side para arquivo de credencial gerenciado pelo ambiente
GOOGLE_APPLICATION_CREDENTIALS=

# 2. Integração Bancária - Lunch Money API v2 (Obrigatório para sincronização real)
LUNCH_MONEY_API_KEY=

# 3. Inteligência Artificial - Gemini 3.7 (Obrigatório para categorização e chat com IA)
GEMINI_API_KEY=

# 4. Provedores Opcionais / Futuros (NÃO obrigatório nesta etapa)
# OPENAI_API_KEY=

# 5. Configurações de Execução e Servidor
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
