# ==============================================================================
# Wealth Planning & Financial Advisory System - Environment Configuration
# ==============================================================================
# IMPORTANT: Never commit actual secret values to version control.
# Copy this file to .env or configure secrets in your deployment environment.

# 1. Gemini AI API Key (Server-side secret only)
# Used for intelligent transaction classification, financial chat assistant, and monthly insights.
GEMINI_API_KEY=

# 2. Lunch Money API Key (Server-side secret fallback / default)
# Configurable per client in the Integrations UI or globally via server secret.
LUNCH_MONEY_API_KEY=

# 3. Server Session Secret (Server-side only)
# Used for HMAC-SHA256 signing of authentication cookies / tokens.
SESSION_SECRET=

# 4. App URL & Environment
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000


